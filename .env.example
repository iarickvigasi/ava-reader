WEB_HOST_PORT=3000
API_HOST_PORT=4000
POSTGRES_HOST_PORT=15432
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Prod only: the browser makes cross-origin fetches to the API (offline sync
# buckets), so the API's CORS allowlist (WEB_ORIGIN) and Clerk's `azp` check
# (CLERK_AUTHORIZED_PARTIES) must name the real web origin — not localhost.
# Leave unset locally to keep the localhost defaults; set both to your served
# web origin(s) in prod (comma-separated for multiple).
WEB_ORIGIN=https://reader.example.com
CLERK_AUTHORIZED_PARTIES=https://reader.example.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → API Keys → JWT public key (PEM). Lets the API verify
# tokens networklessly (no per-request JWKS fetch) so auth works offline.
CLERK_JWT_KEY=
# Keep auth redirects same-origin (the Account Portal fallback bricks offline tabs).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
