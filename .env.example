WEB_HOST_PORT=3000
API_HOST_PORT=4000
POSTGRES_HOST_PORT=15432
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → API Keys → JWT public key (PEM). Lets the API verify
# tokens networklessly (no per-request JWKS fetch) so auth works offline.
CLERK_JWT_KEY=
# Keep auth redirects same-origin (the Account Portal fallback bricks offline tabs).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
