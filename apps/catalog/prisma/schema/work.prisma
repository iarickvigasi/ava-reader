model Work {
  metadataOverrides  String[]        @default([])
  id                 String          @id @default(uuid()) @db.Uuid
  coverImageUrl      String?
  coverId            Int?
  subjects           String[]        @default([])
  categories         String[]        @default([])
  categoryVersion    Int             @default(0)
  metadataIncomplete Boolean         @default(false)
  deletedAt          DateTime?
  originalTitle      String
  originalLanguage   String?
  revision           Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  texts              WorkText[]
  editions           Edition[]
  credits            WorkCredit[]
  sourceMappings     SourceMapping[]

  @@index([categories], type: Gin)
}

model WorkText {
  workId      String  @db.Uuid
  locale      String
  title       String
  description String?
  work        Work    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([workId, locale])
}

model WorkCredit {
  workId     String     @db.Uuid
  authorId   String     @db.Uuid
  role       CreditRole @default(AUTHOR)
  creditedAs String?
  position   Int        @default(0)
  work       Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  author     Author     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([workId, authorId, role])
  @@index([authorId, workId])
}
