{
  "name": "catalog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start:dev": "nest start --watch --no-shell",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test prisma.config.ts",
    "test": "jest --watchman=false",
    "test:integration": "ts-node test/integration.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "import:open-library": "ts-node src/importer/main.ts",
    "import:open-library:prod": "node dist/src/importer/main.js",
    "import:reading-assets": "ts-node src/reading-import/main.ts",
    "import:reading-assets:prod": "node dist/src/reading-import/main.js",
    "test:importer": "ts-node test/importer-integration.ts",
    "test:importer:docker": "ts-node test/importer-worker-smoke.ts",
    "categories:rebuild": "ts-node src/importer/rebuild-categories.main.ts",
    "categories:rebuild:prod": "node dist/src/importer/rebuild-categories.main.js",
    "publish:reading-assets": "ts-node src/reading-import/publication/main.ts",
    "publish:reading-assets:prod": "node dist/src/reading-import/publication/main.js",
    "publish:classics": "ts-node src/reading-import/publication/collection.main.ts",
    "publish:classics:prod": "node dist/src/reading-import/publication/collection.main.js",
    "import:conflicts:prod": "node dist/src/importer/import-conflicts.main.js",
    "import:conflicts": "ts-node src/importer/import-conflicts.main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#catalog-client$": "<rootDir>/generated/client"
    }
  },
  "imports": {
    "#catalog-client": "./generated/client/index.js"
  }
}
