avareader.space {
	encode gzip zstd

	handle_path /catalog/* {
		reverse_proxy catalog:4001
	}

	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}

