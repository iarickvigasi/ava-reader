{
  "name": "ava-reader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:split": "docker compose -f compose.yaml -f compose.dev.yaml up -d postgres api",
    "dev:split:down": "docker compose -f compose.yaml -f compose.dev.yaml stop api postgres",
    "dev:split:logs": "docker compose -f compose.yaml -f compose.dev.yaml logs -f --tail=100 api postgres",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "pnpm --filter api db:generate",
    "db:push": "pnpm --filter api db:push",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down --remove-orphans",
    "docker:reset": "docker compose down -v --remove-orphans",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:verify": "docker compose --profile verify run --rm verify",
    "dev:catalog": "pnpm --filter catalog start:dev",
    "catalog:up": "docker compose up -d --build --wait catalog",
    "catalog:import": "docker compose run --rm --build catalog-importer"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
