    "profile_id": {
      "const": "ava-pdf-prose-en-v2",
      "title": "Profile Id",
      "type": "string"
    },
    "request_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "ava-pdf-worker-result-1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "worker_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Worker Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "source_sha256",
    "request_sha256",
    "config_sha256",
    "worker_fingerprint",
    "profile_id",
    "generation",
    "attempt_fence",
    "cancellation_epoch",
    "outcome"
  ],
  "title": "WorkerResultV1",
  "type": "object"
}
