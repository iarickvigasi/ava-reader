{
  "$comment": "Generated from ava_pdf_epub.contracts. Graph, digest, normalization and authority semantics require the pinned Python validator; structural success never grants readiness.",
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "maximum": 2147483648,
          "minimum": 1,
          "title": "Byte Length",
          "type": "integer"
        },
        "format": {
          "enum": [
            "PDF",
            "CANONICAL_JSON",
            "EPUB",
            "READER_PACKAGE",
            "REPORT_JSON",
            "IMAGE"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "maxLength": 120,
