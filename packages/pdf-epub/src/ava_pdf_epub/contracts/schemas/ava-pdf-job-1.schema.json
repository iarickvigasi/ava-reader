          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "application/json",
            "application/epub+zip",
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "SOURCE_PDF",
            "CANONICAL_BOOK",
            "DERIVED_EPUB",
            "DERIVED_READER",
            "VALIDATION_REPORT",
            "DIAGNOSTIC",
            "RESOURCE"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "format",
        "media_type",
        "path",
        "sha256",
        "byte_length"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
